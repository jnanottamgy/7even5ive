# Rendered films are large and the main cut carries licensed music: share them, don't commit them
video/*.mp4
video/*.wav

# Film build outputs (regenerated by the pipeline in video/source)
video/source/comp/node_modules/
video/source/render/
video/source/probe/
video/source/sfx/
__pycache__/

# 75 core: local env, databases and keys never go in git
core/.venv/
core/data/
.env
*.db
.pytest_cache/
core/.build/
core/.aws-sam/

# Lambda demo build (core/build_lambda_zip.py)
core/.build-lambda/
core/dist/
/app-demo.apk
