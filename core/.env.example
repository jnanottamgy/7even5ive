# Copy to core/.env (git ignores it). Empty values switch to stand-ins, so the demo runs with no
# accounts; the startup log says which parts are live. On the serverless demo the same names live in
# Parameter Store under /7even5ive-demo/ (SecureString). Full steps: docs/keys.md.

# --- our own secrets (any long random strings) ---------------------------------------------------
APPROVAL_SECRET=            # signs one-time approval tokens
TOKEN_ENCRYPTION_KEY=       # encrypts stored Google refresh tokens

# --- the WhatsApp bot (SHELF), docs/library-link.md -------------------------------------------------
BOT_WEBHOOK_SECRET=         # = SEVENTY5_WEBHOOK_SECRET on the bot; signs every pushed event
LIBRARY_URL=                # the bot's public base URL, no trailing slash
LIBRARY_SERVICE_TOKEN=      # = SEVENTY5_SERVICE_TOKEN on the bot
DEMO_PHONE=                 # the number the bot knows the demo student by: 91XXXXXXXXXX

# --- models ----------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=          # Claude Haiku 5.5 for the cascade and the mail judge, or use Bedrock:
BEDROCK_MODEL_ID=           # the Bedrock model or inference-profile id (AWS credentials from the usual chain)
BEDROCK_REGION=             # only if Bedrock is in another region than the code
MAILFILTER_MODEL=           # Bedrock id for the mail judge (default anthropic.claude-haiku-5-5)
JEV_API_KEY=                # OpenRouter key for typesafe/jev-1.14

# --- Google (one Web application OAuth client), docs/keys.md step 8 -----------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=                 # this server's https address, if Google's redirect must be fixed

# --- ElevenLabs: briefing voice, voice assistant, urgent call (docs/voice.md, docs/call.md) ------------
ELEVENLABS_API_KEY=
ELEVENLABS_ASSISTANT_AGENT_ID=   # from: python -m seventy5.voice setup-assistant
ELEVENLABS_AGENT_ID=             # the call agent, from: python -m seventy5.calls setup-agent
ELEVENLABS_PHONE_NUMBER_ID=      # the number imported into ElevenLabs (its id there)
CALL_PROVIDER=twilio             # twilio | exotel | sip
ELEVENLABS_WEBHOOK_SECRET=       # the post-call webhook's HMAC secret
DEMO_STUDENT_PHONE=              # the phone that rings for the demo student: +91XXXXXXXXXX
ELEVENLABS_VOICE_ID=             # optional: one voice for the briefing and both agents

# --- Firebase, only to wake phones (optional) ---------------------------------------------------------
FCM_SERVICE_ACCOUNT_JSON=        # the service account's whole JSON on one line
